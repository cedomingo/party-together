# ---------------------------------------------------------------------------
# Party Together — environment variables
# Copy this file to .env.local for local dev. Set the same keys in
# Vercel Project Settings → Environment Variables for preview/production.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Project URL and anon key: safe to expose to the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, NEVER expose to the client or commit it.
# Used for admin tasks (room cleanup cron, seeding the characters table).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site config -------------------------------------------------------------
# Canonical origin used to build absolute URLs (sitemap, OG tags, share links).
NEXT_PUBLIC_SITE_URL=https://partytogether.com

# --- Vercel Cron / cleanup endpoint -----------------------------------------
# Shared secret checked by /api/cron/cleanup-rooms so only Vercel Cron
# (or Supabase scheduled function) can trigger room expiry cleanup.
CRON_SECRET=

# --- Cloudflare --------------------------------------------------------------
# Not consumed directly by the app at runtime (Cloudflare sits in front of
# Vercel at the DNS/WAF layer), but documented here since it's part of the
# deployment. Populate when wiring up Cloudflare per §10 of SPEC.md.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
